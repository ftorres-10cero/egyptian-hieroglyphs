msgstr "Kartusche mit einem Quadrat (höher)"

#: includes/class-settings.php:486
msgid "VERTICAL CARTOUCHE: stacked signs; the oval grows taller"
msgstr "VERTIKALE KARTUSCHE: gestapelte Zeichen; das Oval wird höher"

#: includes/class-settings.php:491
msgid "Cartouche with two juxtaposed words"
msgstr "Kartusche mit zwei aneinandergereihten Wörtern"

#: includes/class-settings.php:501
msgid "Walled enclosure"
msgstr "Umwallte Umschließung"

#: includes/class-settings.php:506
msgid "Cartouche, H variant"
msgstr "Kartusche, Variante H"

#: includes/class-settings.php:511
