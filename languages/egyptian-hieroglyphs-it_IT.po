msgid "Agrupa signos en horizontal"
msgstr "Raggruppa i segni orizzontalmente"

msgid "Alineación"
msgstr "Allineamento"

msgid "Alineación del bloque."
msgstr "Allineamento del blocco."

msgid "Altura de línea"
msgstr "Altezza della riga"

msgid "Altura de línea (multiplicador)."
msgstr "Altezza della riga (moltiplicatore)."

msgid "Anillo shen"
msgstr "Anello shen"

msgid "Apila signos en vertical (cuadratura)"
msgstr "Impila i segni verticalmente (quadrato)"

msgid "Atributo"
msgstr "Attributo"

msgid "Avanzado"
msgstr "Avanzate"

msgid "Ayuda"
msgstr "Aiuto"

msgid "CARTUCHO VERTICAL: signos apilados; el óvalo crece en altura"
msgstr "CARTIGLIO VERTICALE: segni impilati; l'ovale cresce in altezza"

msgid "Cartucho / cerramiento"
msgstr "Cartiglio / contenitore"

msgid "Cartucho con b inicial"
msgstr "Cartiglio con b iniziale"

msgid "Cartucho con dos palabras yuxtapuestas"
msgstr "Cartiglio con due parole giustapposte"

msgid "Cartucho con un nombre real (Menkheperre)"
msgstr "Cartiglio con un nome reale (Menkheperre)"

msgid "Cartucho con un signo inicial dentro (complemento fonético: s, b, h, 1…)"
msgstr "Cartiglio con un segno iniziale dentro (complemento fonetico: s, b, h, 1…)"

msgid "Cartucho con una cuadratura (más alto)"
msgstr "Cartiglio con un quadrato (più alto)"

msgid "Cartucho simple"
msgstr "Cartiglio semplice"

msgid "Cartucho, variante H"
msgstr "Cartiglio, variante H"

msgid "Cartuchos (todas las variantes)"
msgstr "Cartigli (tutte le varianti)"

msgid "Centro"
msgstr "Centro"

msgid "Cerramiento amurallado"
msgstr "Contenitore fortificato"

msgid "Codificación Unicode"
msgstr "Codifica Unicode"

msgid "Codificación Unicode (avanzado)"
msgstr "Codifica Unicode (avanzata)"

msgid "Codificación Unicode generada"
msgstr "Codifica Unicode generata"

msgid "Color de los signos"
msgstr "Colore dei segni"

msgid "Color de los signos (vacío = hereda el tema)."
msgstr "Colore dei segni (vuoto = eredita il tema)."

msgid "Color en formato hexadecimal. Vacío = hereda el color del tema."
msgstr "Colore in formato esadecimale. Vuoto = eredita il colore del tema."

msgid "Consejos y preguntas frecuentes"
msgstr "Consigli e domande frequenti"

msgid "Conversor MdC"
msgstr "Convertitore MdC"

msgid "Conversor MdC (jeroglíficos)"
msgstr "Convertitore MdC (geroglifici)"

msgid "Conversor de Manuel de Codage (MdC) a Unicode jeroglífico"
msgstr "Convertitore da Manuel de Codage (MdC) a Unicode geroglifico"

msgid "Convertir"
msgstr "Converti"

msgid "Copiar al portapapeles"
msgstr "Copia negli appunti"

msgid "Corchetes literales (no es un cartucho)"
msgstr "Parentesi letterali (non un cartiglio)"

msgid "Créditos"
msgstr "Crediti"

msgid "Código de un signo (lista de Gardiner). Sin separador, los signos se suceden en la línea."
msgstr "Codice di un segno (lista di Gardiner). Senza separatore, i segni si susseguono sulla riga."

msgid "Códigos de signos (nTr, ra, anx…) con separadores: \":\" (vertical), \"*\" (horizontal), \"-\" (yuxtaposición). Cartuchos con \"<\" y \">\" (ej.: <- mn-xpr-ra ->). Guía completa en Ajustes → Jeroglíficos Egipcios."
msgstr "Codici di segni (nTr, ra, anx…) con separatori: \":\" (verticale), \"*\" (orizzontale), \"-\" (giustapposizione). Cartigli con \"<\" e \">\" (es.: <- mn-xpr-ra ->). Guida completa in Impostazioni → Geroglifici Egizi."

msgid "Cómo escribir jeroglíficos"
msgstr "Come scrivere i geroglifici"

msgid "Derecha"
msgstr "Destra"

msgid "Derecha → izquierda (jeroglífico)"
msgstr "Destra → sinistra (geroglifico)"

msgid "Descripción"
msgstr "Descrizione"

msgid "Dirección"
msgstr "Direzione"

msgid "Dirección: izquierda→derecha o derecha→izquierda."
msgstr "Direzione: sinistra→destra o destra→sinistra."

msgid "Editar la codificación Unicode directamente"
msgstr "Modifica direttamente la codifica Unicode"

msgid "Ejemplo"
msgstr "Esempio"

msgid "Ejemplos completos"
msgstr "Esempi completi"

msgid "El bloque se personaliza por cada inserción desde su panel de opciones; los valores por defecto de esta página solo afectan a bloques nuevos y al shortcode."
msgstr "Ogni blocco si personalizza singolarmente dal suo pannello di opzioni; i valori predefiniti di questa pagina valgono solo per i nuovi blocchi e per lo shortcode."

msgid "El egipcio clásico se lee de derecha a izquierda."
msgstr "L'egiziano classico si legge da destra a sinistra."

msgid "El shortcode se usa en el editor clásico y acepta la codificación Unicode jeroglífica (una línea por fragmento):"
msgstr "Lo shortcode si usa nell'editor classico e accetta la codifica Unicode geroglifica (una riga per frammento):"

msgid "En el editor de entradas, añade el bloque «%s»."
msgstr "Nell'editor dei post, aggiungi il blocco «%s»."

msgid "Escribe en el cuadro «Texto en notación MdC» los códigos de los signos, combinándolos con los separadores de la referencia siguiente."
msgstr "Inserisci nel campo «Testo in notazione MdC» i codici dei segni, combinandoli con i separatori del riferimento seguente."

msgid "Escribe la codificación jeroglífica Unicode directamente (caracteres U+13000+ y controles de cuadratura)."
msgstr "Inserisci direttamente la codifica Unicode geroglifica (caratteri U+13000+ e controlli di quadrato)."

msgid "Escribe una frase en notación MdC (una línea por fragmento) y conviértela a la codificación Unicode que renderiza hierojax. Usa el resultado en el shortcode [hiero] o como referencia para el bloque."
msgstr "Inserisci una frase in notazione MdC (una riga per frammento) e convertila nella codifica Unicode renderizzata da hierojax. Usa il risultato nello shortcode [hiero] o come riferimento per il blocco."

msgid "Herramientas → Conversor MdC"
msgstr "Strumenti → Convertitore MdC"

msgid "Izquierda"
msgstr "Sinistra"

msgid "Izquierda → derecha"
msgstr "Sinistra → destra"

msgid "Jeroglíficos Egipcios"
msgstr "Geroglifici Egizi"

msgid "Jeroglíficos egipcios (MdC)"
msgstr "Geroglifici egizi (MdC)"

msgid "Jeroglíficos egipcios (MdC) — ajustes"
msgstr "Geroglifici egizi (MdC) — impostazioni"

msgid "La conversión contiene signos no disponibles en Unicode (�). Revisa los códigos MdC."
msgstr "La conversione contiene segni non disponibili in Unicode (�). Controlla i codici MdC."

msgid "La fuente NewGardiner se sirve desde el propio plugin. Si el hosting no permitió incluirla (límite de subida), el plugin la carga automáticamente desde la CDN oficial de HieroJax (%s)."
msgstr "Il font NewGardiner viene servito dal plugin stesso. Se l'hosting non ha permesso di includerlo (limite di upload), il plugin lo carica automaticamente dalla CDN ufficiale di HieroJax (%s)."

msgid "La vista previa aparecerá aquí. Escribe una frase en MdC arriba."
msgstr "L'anteprima apparirà qui. Inserisci sopra una frase in MdC."

msgid "La vista previa se genera al instante. En el panel lateral del bloque ajusta tamaño, color, dirección, separación y sombreado."
msgstr "L'anteprima viene generata all'istante. Nel pannello laterale del blocco regola dimensione, colore, direzione, spaziatura e tratteggio."

msgid "Los cartuchos (nombres reales dentro de un óvalo) se escriben con los cerramientos < y >. El óvalo se adapta al contenido: si apilas signos con \":\", el cartucho se vuelve vertical."
msgstr "I cartigli (nomi reali dentro un ovale) si scrivono con i contenitori < e >. L'ovale si adatta al contenuto: se impili i segni con \":\", il cartiglio diventa verticale."

msgid "Los scripts y la fuente solo se cargan en páginas que contienen jeroglíficos, para no ralentizar el resto del sitio."
msgstr "Script e font vengono caricati solo nelle pagine che contengono geroglifici, per non rallentare il resto del sito."

msgid "Los signos siguen la lista de Gardiner: cada uno tiene un código (p. ej. nTr = dios, ra = sol) y se combinan con separadores para formar cuadraturas, grupos y palabras."
msgstr "I segni seguono la lista di Gardiner: ognuno ha un codice (es. nTr = dio, ra = sole) e si combina con separatori per formare quadrati, gruppi e parole."

msgid "Marca el texto en rojo (papiros; sufijo)"
msgstr "Marca il testo in rosso (papiri; suffisso)"

msgid "Motor de render y conversor: %1$s (GPL-3.0). Fuente: %2$s (SIL OFL 1.1). Ambos de Mark-Jan Nederhof (Universidad de St Andrews)."
msgstr "Motore di rendering e convertitore: %1$s (GPL-3.0). Font: %2$s (SIL OFL 1.1). Entrambi di Mark-Jan Nederhof (Università di St Andrews)."

msgid "Opciones de visualización"
msgstr "Opzioni di visualizzazione"

msgid "Orientación, rotación y sombreado"
msgstr "Orientamento, rotazione e tratteggio"

msgid "Para cambiar la orientación de toda la línea usa la opción \"Dirección\" del bloque (derecha → izquierda, como el egipcio clásico). Para rotar o sombrear un signo concreto, los modificadores van DESPUÉS del signo (sufijo):"
msgstr "Per cambiare l'orientamento dell'intera riga, usa l'opzione «Direzione» del blocco (destra → sinistra, come l'egiziano classico). Per ruotare o tratteggiare un singolo segno, i modificatori vanno DOPO il segno (suffisso):"

msgid "Patrón de sombreado de los signos dañados."
msgstr "Motivo di tratteggio per i segni danneggiati."

msgid "Permitir saltos de línea en fragmentos largos."
msgstr "Consenti interruzioni di riga nei frammenti lunghi."

msgid "Permitir saltos de línea largos"
msgstr "Consenti interruzioni di riga lunghe"

msgid "Publica la entrada: los jeroglíficos se renderizan como SVG nítido, ampliable y copiable para tus lectores."
msgstr "Pubblica il post: i geroglifici vengono renderizzati come SVG nitido, ingrandibile e copiabile per i tuoi lettori."

msgid "Qué hace"
msgstr "Cosa fa"

msgid "Rayado (hatching)"
msgstr "Tratteggio (hatching)"

msgid "Referencia de la sintaxis (tags)"
msgstr "Riferimento della sintassi (tag)"

msgid "Resultado"
msgstr "Risultato"

msgid "Rota el signo anterior (sufijo tras el signo)"
msgstr "Ruota il segno precedente (suffisso dopo il segno)"

msgid "Rota el signo anterior (variantes de la fuente)"
msgstr "Ruota il segno precedente (varianti del font)"

msgid "Rota el signo anterior 90°, 180° o 270°"
msgstr "Ruota il segno precedente di 90°, 180° o 270°"

msgid "Separa palabras"
msgstr "Separa le parole"

msgid "Separación entre signos"
msgstr "Spaziatura dei segni"

msgid "Separación entre signos."
msgstr "Spaziatura dei segni."

msgid "Shortcode [hiero]"
msgstr "Shortcode [hiero]"

msgid "Si no recuerdas la codificación Unicode de un fragmento, usa la herramienta %s para convertir MdC a Unicode con un clic y copiarlo."
msgstr "Se non ricordi la codifica Unicode di un frammento, usa lo strumento %s per convertire il MdC in Unicode con un clic e copiarlo."

msgid "Si un código MdC no está aún codificado en Unicode, la vista previa muestra el carácter � y el editor avisa. Revisa el código o usa la codificación Unicode manual."
msgstr "Se un codice MdC non è ancora codificato in Unicode, l'anteprima mostra il carattere � e l'editor avvisa. Controlla il codice o usa la codifica Unicode manuale."

msgid "Sombreado"
msgstr "Tratteggio"

msgid "Sombreado del signo anterior (1-4 = esquinas)"
msgstr "Tratteggia il segno precedente (1-4 = angoli)"

msgid "Superpone un signo sobre otro"
msgstr "Sovrappone un segno su un altro"

msgid "Tag"
msgstr "Tag"

msgid "Tamaño de los signos"
msgstr "Dimensione dei segni"

msgid "Tamaño de los signos (por defecto: el de los ajustes)."
msgstr "Dimensione dei segni (predefinita: quella delle impostazioni)."

msgid "Tamaño en píxeles de la altura de los signos (8–200)."
msgstr "Altezza dei segni in pixel (8–200)."

msgid "También puedes marcar un fragmento en rojo (papiros) escribiendo %s al final del texto."
msgstr "Puoi anche marcare un frammento in rosso (papiri) scrivendo %s alla fine del testo."

msgid "Termina el fragmento actual"
msgstr "Termina il frammento corrente"

msgid "Texto MdC"
msgstr "Testo MdC"

msgid "Texto en MdC"
msgstr "Testo in MdC"

msgid "Texto en notación MdC"
msgstr "Testo in notazione MdC"

msgid "Transposiciones horizontal, vertical y de reordenación"
msgstr "Trasposizioni orizzontale, verticale e di riordino"

msgid "Uniforme"
msgstr "Uniforme"

msgid "Valores"
msgstr "Valori"

msgid "Valores por defecto aplicados a los bloques nuevos y al shortcode [hiero]. Cada bloque puede personalizar tamaño y color individualmente."
msgstr "Valori predefiniti applicati ai nuovi blocchi e allo shortcode [hiero]. Ogni blocco può personalizzare dimensione e colore singolarmente."

msgid "Ver codificación Unicode"
msgstr "Vedi codifica Unicode"

msgid "Vista previa"
msgstr "Anteprima"

msgid "Yuxtapone signos en la misma línea"
msgstr "Giustappone i segni sulla stessa riga"

msgid "espacio"
msgstr "spazio"

msgid "Útil para cartuchos u otros detalles que la conversión automática no conserva."
msgstr "Utile per cartigli o altri dettagli che la conversione automatica non conserva."
