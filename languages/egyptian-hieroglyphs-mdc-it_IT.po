#: build/index.js:1
msgid "Sign codes (nTr, ra, anx…) with separators: \":\" (vertical), \"*\" (horizontal), \"-\" (juxtaposition). Cartouches with \"<\" and \">\" (e.g. <- mn-xpr-ra ->). Full guide in Settings → Egyptian Hieroglyphs."
msgstr "Codici di segni (nTr, ra, anx…) con separatori: \":\" (verticale), \"*\" (orizzontale), \"-\" (giustapposizione). Cartigli con \"<\" e \">\" (es.: <- mn-xpr-ra ->). Guida completa in Impostazioni → Geroglifici Egizi."

#: build/index.js:1
msgid "The preview will appear here. Type an MdC phrase above."
msgstr "L'anteprima apparirà qui. Inserisci sopra una frase in MdC."

