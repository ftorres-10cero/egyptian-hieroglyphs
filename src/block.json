{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "egyptian-hieroglyphs/hiero",
  "version": "1.5.9",
  "title": "Egyptian Hieroglyphs (MdC)",
  "category": "widgets",
  "icon": "translation",
  "description": "Renders Egyptian hieroglyphs from Manuel de Codage (MdC) notation, using HieroJax and the NewGardiner font.",
  "keywords": [
    "hieroglyph",
    "egyptian",
    "egyptology",
    "mdc",
    "transliteration"
  ],
  "textdomain": "egyptian-hieroglyphs-mdc",
  "attributes": {
    "mdc": {
      "type": "string",
      "default": ""
    },
    "unicode": {
      "type": "string",
      "default": ""
    },
    "fontSize": {
      "type": "number"
    },
    "textAlign": {
      "type": "string",
      "default": "left"
    },
    "color": {
      "type": "string"
    },
    "dir": {
      "type": "string",
      "default": "ltr"
    },
    "sep": {
      "type": "number",
      "default": 0.1
    },
    "shade": {
      "type": "string",
      "default": "uniform"
    },
    "linesize": {
      "type": "number",
      "default": 1
    },
    "separated": {
      "type": "boolean",
      "default": false
    },
    "showSource": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false,
    "multiple": true,
    "reusable": true
  }
}
